# =========================================================
# SERVER
# =========================================================

NODE_ENV=production
PORT=3000

# =========================================================
# DATABASE
# =========================================================

MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/betawin?retryWrites=true&w=majority

# =========================================================
# AUTHENTICATION
# =========================================================

JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET_HERE
JWT_EXPIRES_IN=7d

# =========================================================
# FRONTEND
# =========================================================

CLIENT_URL=https://YOUR-FRONTEND-DOMAIN.com

# =========================================================
# MPESA DARAJA
# =========================================================

MPESA_ENVIRONMENT=sandbox

MPESA_CONSUMER_KEY=YOUR_DARAJA_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_DARAJA_CONSUMER_SECRET

MPESA_SHORTCODE=YOUR_SANDBOX_SHORTCODE
MPESA_PASSKEY=YOUR_DARAJA_PASSKEY

MPESA_CALLBACK_URL=https://YOUR-RENDER-SERVICE.onrender.com/api/payments/callback

MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
